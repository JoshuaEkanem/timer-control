<Window x:Class="ChurchTimer.OutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Timer Output" Width="640" Height="360" Background="Black">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Viewbox Margin="40,40,40,10">
            <TextBlock x:Name="TimeText" Text="05:00" Foreground="White"
                       FontFamily="Consolas" FontSize="200"/>
        </Viewbox>

        <TextBlock x:Name="MessageText" Grid.Row="1" Foreground="#FFD54F"
                   FontFamily="Segoe UI" FontSize="60" FontWeight="SemiBold"
                   TextWrapping="Wrap" TextAlignment="Center"
                   Margin="40,0,40,40" Visibility="Collapsed"/>
    </Grid>
</Window>